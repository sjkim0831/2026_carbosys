**/node_modules/
.git/
.idea/
.vscode/
*.log
*.tmp
docker-compose/cubrid/data/
docker-compose/cubrid/init/
data/
logs/
file/
backup/
var/
wsl.localhost/

# IDE metadata is not required for container builds.
**/.settings/
**/.classpath
**/.project

# Container-internal Maven build needs full module sources and build descriptors.
# Keep module/** available (src, pom.xml, .mvn, etc.) so Dockerfile COPY + mvn package works.

# Keep mappings and ports for MsaManager
!msa-mappings.yml
!msa-ports.yml

# Exclude local build outputs from host context.
**/target/*
# Keep prebuilt JARs if any image path still references them.
!**/target/*.jar

# Docker image builds only need prebuilt module JARs, not module sources.
module/**
!module/
!module/*/
!module/*/target/
!module/*/target/*.jar
